<Window x:Class="UpgradeUpdateRvt.ApplicatioUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UpgradeUpdateRvt"
        mc:Ignorable="d"
        Title="Mise à jour / Upgrade Revit Files" Height="520" Width="920"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderText">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <!-- Ajout d'un style local pour remplacer MaterialDesignRaisedAccentButton -->
        <Style x:Key="RaisedAccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#333" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="Dossier de projet" Style="{StaticResource HeaderText}"/>

        <!-- Chemin + Préfixe + Bouton Parcourir -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Label Préfixe -->
                <ColumnDefinition Width="140"/>
                <!-- Champ Préfixe -->
                <ColumnDefinition Width="*"/>
                <!-- Chemin -->
                <ColumnDefinition Width="Auto"/>
                <!-- Bouton -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
               Text="Préfixe :" 
               VerticalAlignment="Center" 
               Margin="0,0,8,0"/>

            <TextBox Grid.Column="1" 
             Text="{Binding Init.Prefix, UpdateSourceTrigger=PropertyChanged}" 
             Margin="0,0,12,0" 
             Padding="6"
             VerticalContentAlignment="Center"/>

            <TextBox Grid.Column="2" 
             Text="{Binding Init.MainPath, UpdateSourceTrigger=PropertyChanged}" 
             Margin="0,0,8,0" 
             Padding="8" 
             VerticalContentAlignment="Center"/>

            <Button Grid.Column="3" 
            Content="Parcourir..." 
            Command="{Binding BrowseFolderCommand}"/>
        </Grid>

        <!-- Liste des fichiers -->
        <DataGrid Grid.Row="2" Margin="0,16,0,0"
                  ItemsSource="{Binding Init.ListFiles, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#FAFCFF">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Fichier original" Binding="{Binding OriginFilename}" Width="*"/>
                <DataGridTextColumn Header="Nouveau nom"     Binding="{Binding NewFileName}"    Width="*"/>
                <DataGridCheckBoxColumn Header="Workshared"   Binding="{Binding Workshared}"   Width="90"/>
                <DataGridCheckBoxColumn Header="Converti"     Binding="{Binding Coverted}"     Width="90"/>
                <DataGridTextColumn Header="Statut"           Binding="{Binding Status}"       Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Boutons actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Actualiser" Command="{Binding RefreshCommand}"/>
            <Button Content="Lancer la conversion" Command="{Binding ConvertCommand}" 
                    Style="{StaticResource RaisedAccentButton}"/>
        </StackPanel>
    </Grid>
</Window>
